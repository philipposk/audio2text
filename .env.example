# --- Translator: environment variables ---
# Copy this file to `.env` and fill in the values you have.

# Required for cloud transcription + audio→English translation (Whisper).
# If absent, the server falls back to local Whisper (transcribe-only, slower).
OPENAI_API_KEY=

# Preferred for chat/refinement and text translation (Groq is fast + cheap).
# If absent, falls back to OpenAI.
GROQ_API_KEY=

# Server config.
PORT=3000
NODE_ENV=development

# URL ingest allowlist (comma-separated hostnames). Optional — defaults to
# YouTube/Vimeo/SoundCloud if unset.
# INGEST_ALLOWED_HOSTS=youtube.com,youtu.be,vimeo.com,soundcloud.com

# Diarization via Replicate (pyannote/whisper-diarization). Optional.
# REPLICATE_API_TOKEN=
# REPLICATE_DIARIZE_MODEL=thomasmol/whisper-diarization:cbd15da9f839c5f932742f86ce7def3a03c22e2b4171d42823e83e314547003f

# Telegram bot. Set webhook to: https://YOUR_DOMAIN/api/messaging/telegram?secret=$TELEGRAM_WEBHOOK_SECRET
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# Twilio WhatsApp. Set webhook to: https://YOUR_DOMAIN/api/messaging/whatsapp
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=

# API key auth.
#   API_KEYS_REQUIRED=true   forces all /api callers to send x-api-key.
#   ADMIN_API_KEY=<secret>   unlocks /api/keys management routes.
# API_KEYS_REQUIRED=false
# ADMIN_API_KEY=

# Async job queue + batch concurrency.
# QUEUE_WORKERS=2
# BATCH_CONCURRENCY=2

# Logging.
# LOG_LEVEL=info

# Messaging webhooks (optional).
# MESSENGER_VERIFY_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=
