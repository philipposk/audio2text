# --- Translator: environment variables ---
# Copy this file to `.env` and fill in the values you have.

# Transcription + audio→English translation.
# Groq Whisper is the PRIMARY transcription engine (~9x cheaper + faster); set
# GROQ_API_KEY to enable it. OpenAI is the fallback, and is REQUIRED for the
# audio→English "translate" task (Groq's turbo model doesn't support it).
# With neither key, the server uses local Whisper (transcribe-only, slower).
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional model overrides (defaults shown). Bump if a model is decommissioned —
# no code change needed. Set OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe for a
# higher-accuracy (but pricier) transcription fallback.
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_CHAT_MODEL=gpt-4o-mini
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Persistence. With BOTH of these set, jobs/glossaries/keys are stored in
# Supabase (recommended for Vercel/production). Without them, the server uses a
# local JSON file (data/translator.json) — fine for self-hosted single-instance.
# Get the service_role key from Supabase dashboard → Settings → API.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=

# Server config.
PORT=3000
NODE_ENV=development

# URL ingest allowlist (comma-separated hostnames). Optional — defaults to
# YouTube/Vimeo/SoundCloud if unset.
# INGEST_ALLOWED_HOSTS=youtube.com,youtu.be,vimeo.com,soundcloud.com

# Diarization via Replicate (pyannote/whisper-diarization). Optional.
# REPLICATE_API_TOKEN=
# REPLICATE_DIARIZE_MODEL=thomasmol/whisper-diarization:cbd15da9f839c5f932742f86ce7def3a03c22e2b4171d42823e83e314547003f

# Telegram bot. Set webhook to: https://YOUR_DOMAIN/api/messaging/telegram?secret=$TELEGRAM_WEBHOOK_SECRET
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# Twilio WhatsApp. Set webhook to: https://YOUR_DOMAIN/api/messaging/whatsapp
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=

# API key auth.
#   API_KEYS_REQUIRED=true   forces all /api callers to send x-api-key.
#   ADMIN_API_KEY=<secret>   unlocks /api/keys management routes.
# API_KEYS_REQUIRED=false
# ADMIN_API_KEY=

# Async job queue + batch concurrency.
# QUEUE_WORKERS=2
# BATCH_CONCURRENCY=2

# Logging.
# LOG_LEVEL=info

# Messaging webhooks (optional).
# MESSENGER_VERIFY_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=
