{
  "name": "translator",
  "version": "2.0.0",
  "description": "Audio → text → translation web app with AI refinement, diarization-ready, multi-language",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "PORT=3000 nodemon server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "build:pages": "vite build && echo 'Frontend built to docs/ folder for GitHub Pages'",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint server tests",
    "lint:fix": "eslint server tests --fix"
  },
  "keywords": [
    "transcription",
    "translation",
    "audio",
    "whisper",
    "ai",
    "greek",
    "subtitles",
    "diarization"
  ],
  "author": "Philippos Ktistakis",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "docx": "^8.2.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.0",
    "express-ws": "^5.0.2",
    "ffmpeg-static": "^5.3.0",
    "groq-sdk": "^0.37.0",
    "lowdb": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.20.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "wav": "^1.0.2",
    "ws": "^8.14.2",
    "youtube-dl-exec": "^3.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "nodemon": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "supertest": "^7.0.0",
    "vite": "^5.0.8",
    "vitest": "^2.1.0"
  }
}
